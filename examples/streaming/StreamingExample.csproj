<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ExampleTfm Condition="'$(ExampleTfm)' == ''">net10.0</ExampleTfm>
    <TargetFramework>$(ExampleTfm)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StreamingExample</RootNamespace>
    <IsPackable>false</IsPackable>
    <OrmLiteUsesPackedPackages>true</OrmLiteUsesPackedPackages>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(ArtifactsPath)/generated/StreamingExample</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Neemle.OrmLite" Version="[$(OrmLiteVersion)]" />
    <PackageReference Include="Neemle.OrmLite.Sqlite" Version="[$(OrmLiteVersion)]" />
    <PackageReference Include="Neemle.OrmLite.Postgres" Version="[$(OrmLiteVersion)]" />
  </ItemGroup>
</Project>
