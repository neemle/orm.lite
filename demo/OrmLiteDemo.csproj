<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OrmLiteDemo</AssemblyName>
    <RootNamespace>OrmLiteDemo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Neemle.OrmLite" Version="0.1.0-pre" />
    <PackageReference Include="Neemle.OrmLite.Sqlite" Version="0.1.0-pre" />
    <PackageReference Include="Neemle.OrmLite.Postgres" Version="0.1.0-pre" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
