<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DemoTfm Condition="'$(DemoTfm)' == ''">net10.0</DemoTfm>
    <TargetFramework>$(DemoTfm)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OrmLiteDemo</AssemblyName>
    <RootNamespace>OrmLiteDemo</RootNamespace>
    <OrmLiteUsesPackedPackages>true</OrmLiteUsesPackedPackages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Neemle.OrmLite" Version="[$(OrmLiteVersion)]" />
    <PackageReference Include="Neemle.OrmLite.Sqlite" Version="[$(OrmLiteVersion)]" />
    <PackageReference Include="Neemle.OrmLite.Postgres" Version="[$(OrmLiteVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
