<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../Packaging.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>PostgreSQL provider for Neemle.OrmLite: the serializer, the capability manifest, the Npgsql data source and the connection gate. Referencing this package registers the provider, so OrmLiteOptions.Provider = "postgres" resolves with no further code. Requires the Neemle.OrmLite package of the same version.</Description>
    <PackageTags>orm;postgresql;npgsql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(OrmLiteRoot).Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/Core.csproj" PrivateAssets="none" />
    <ProjectReference Include="../Runtime/Runtime.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Sql/Sql.csproj" PrivateAssets="all" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="assets/Neemle.OrmLite.Postgres.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="assets/ormlite.capabilities.postgres.txt" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

</Project>
