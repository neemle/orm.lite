<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../Packaging.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Neemle.Orm.Lite</PackageId>
    <Description>Attribute-driven ORM for .NET: source generator, soft delete, row history, typed queries</Description>
    <PackageTags>orm;source-generator;migrations;soft-delete;postgresql;sqlite</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Neemle.CSharpComposer" Version="$(OrmLiteComposerVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Neemle.Orm.Lite.Generator/Neemle.Orm.Lite.Generator.csproj" ReferenceOutputAssembly="false" OutputItemType="OrmLiteAnalyzerAssembly" />
    <ProjectReference Include="../Neemle.Orm.Lite.Runtime/Neemle.Orm.Lite.Runtime.csproj" ReferenceOutputAssembly="false" OutputItemType="OrmLiteRuntimeAssembly" />
    <ProjectReference Include="../Neemle.Orm.Lite.Sql/Neemle.Orm.Lite.Sql.csproj" ReferenceOutputAssembly="false" OutputItemType="OrmLiteSqlAssembly" />
  </ItemGroup>

  <Target Name="OrmLitePackContent" BeforeTargets="_GetPackageFiles" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <None Include="@(OrmLiteAnalyzerAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs/" />
      <None Include="@(OrmLiteRuntimeAssembly)" Pack="true" PackagePath="lib/net10.0/" />
      <None Include="@(OrmLiteSqlAssembly)" Pack="true" PackagePath="lib/net10.0/" />
      <None Include="@(OrmLiteRuntimeAssembly->'%(RootDir)%(Directory)%(Filename).xml')"
            Pack="true" PackagePath="lib/net10.0/" />
      <None Include="@(OrmLiteSqlAssembly->'%(RootDir)%(Directory)%(Filename).xml')"
            Pack="true" PackagePath="lib/net10.0/" />
      <None Include="assets/Neemle.Orm.Lite.props" Pack="true" PackagePath="buildTransitive/" />
      <None Include="assets/Neemle.Orm.Lite.targets" Pack="true" PackagePath="buildTransitive/" />
    </ItemGroup>
  </Target>

</Project>
