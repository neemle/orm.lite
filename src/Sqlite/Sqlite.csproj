<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../Packaging.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>SQLite provider for Neemle.OrmLite: the serializer, the capability manifest, the Microsoft.Data.Sqlite data source, the value codec and the single-writer gate. Referencing this package registers the provider, so OrmLiteOptions.Provider = "sqlite" resolves with no further code. Requires the Neemle.OrmLite package of the same version.</Description>
    <PackageTags>orm;sqlite</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(OrmLiteRoot).Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/Core.csproj" PrivateAssets="none" />
    <ProjectReference Include="../Runtime/Runtime.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Sql/Sql.csproj" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <None Include="assets/Neemle.OrmLite.Sqlite.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="assets/ormlite.capabilities.sqlite.txt" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

</Project>
