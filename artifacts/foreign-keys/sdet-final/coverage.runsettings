<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration><Format>Cobertura</Format><CodeCoverage>
          <ModulePaths><Include>
            <ModulePath>.*Neemle.OrmLite.Runtime.dll$</ModulePath>
            <ModulePath>.*Neemle.OrmLite.Generator.dll$</ModulePath>
          </Include></ModulePaths>
        </CodeCoverage></Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
