      <RunInfo computerName="b21f193f5bd8" outcome="Warning" timestamp="2026-11-26T15:33:28.6691349+00:00">
        <Text>[xUnit.net 00:02:33.80]     a column matched against a list of values finds exactly those rows, and an empty list finds none [SKIP]</Text>
