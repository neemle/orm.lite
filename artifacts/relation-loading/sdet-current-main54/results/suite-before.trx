      <RunInfo computerName="b21f193f5bd8" outcome="Warning" timestamp="2026-11-26T15:33:28.6968210+00:00">
        <Text>[xUnit.net 00:02:33.83]     adding minutes to the database clock lands that far ahead, or is refused before any statement runs [SKIP]</Text>
