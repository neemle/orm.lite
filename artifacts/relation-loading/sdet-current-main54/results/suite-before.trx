      <RunInfo computerName="b21f193f5bd8" outcome="Warning" timestamp="2026-11-26T15:33:28.5273868+00:00">
        <Text>[xUnit.net 00:02:33.66]     a row inserted through the library reads back with every value type intact [SKIP]</Text>
