<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PolicySmokeTfm Condition="'$(PolicySmokeTfm)' == ''">net10.0</PolicySmokeTfm>
    <TargetFramework>$(PolicySmokeTfm)</TargetFramework>
    <PublishAot Condition="'$(PolicySmokeNative)' == 'true'">true</PublishAot>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PolicySmoke</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/Runtime/Runtime.csproj" />
    <ProjectReference Include="../../../../src/Sql/Sql.csproj" />
    <ProjectReference Include="../../../../src/Sqlite/Sqlite.csproj" />
    <ProjectReference Include="../../../../src/Postgres/Postgres.csproj" />
    <ProjectReference Include="../../../../src/Generator/Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Neemle.CSharpComposer" Version="$(OrmLiteComposerVersion)" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
    <Analyzer Include="$(PkgNeemle_CSharpComposer)/lib/net10.0/Neemle.CSharpComposer.dll" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../../../examples/relation-loading/*.cs" Exclude="../../../../examples/relation-loading/Program.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>