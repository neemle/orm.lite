<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <BridgeNativeTfm Condition="'$(BridgeNativeTfm)' == ''">net10.0</BridgeNativeTfm>
    <TargetFramework>$(BridgeNativeTfm)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/Runtime/Runtime.csproj" />
    <ProjectReference Include="../../../../src/Core/Core.csproj" />
    <ProjectReference Include="../../../../src/Sql/Sql.csproj" />
    <ProjectReference Include="../../../../src/Postgres/Postgres.csproj" />
    <ProjectReference Include="../../../../src/Sqlite/Sqlite.csproj" />
  </ItemGroup>
</Project>
