<Project>

  <!-- The runtime assembly is compiled into a consumer's AOT binary by ILC, so its AOT analyzers must be on in this
       build. IsAotCompatible is unconditional on purpose: a TargetFramework condition never matches here (the
       property is read before the project body sets it), the analyzers would stay off, and the build would still
       exit 0. -->
  <PropertyGroup>
    <OrmLiteVersion>0.1.0-pre</OrmLiteVersion>
    <!-- Every project of the repository, shipped or not, carries the one version: the Runtime, Sql and Generator
         assemblies are packed into the core package and must not keep the SDK default 1.0.0. AssemblyVersion and
         FileVersion are derived from it (0.1.0-pre gives 0.1.0.0); scripts/PackVersions.cs asserts all three
         version stamps of every packed assembly. -->
    <Version>$(OrmLiteVersion)</Version>
    <!-- The one place the version of the code generation library is written: the generator project and the core
         package project both take it, scripts/PackCheck.cs compares the packed dependency with it. -->
    <OrmLiteComposerVersion>0.5.0</OrmLiteComposerVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);CS8785;IL2026;IL3050</WarningsAsErrors>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <!-- Rewrites source paths to /_/ in the debug information. That is for the build that is published, so it is on
         in CI only: a local build keeps the real paths, which a contributor needs to step through the code. -->
    <OrmLiteOnCi Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(CI)' == 'true'">true</OrmLiteOnCi>
    <ContinuousIntegrationBuild Condition="'$(OrmLiteOnCi)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Debuggability of the shipped assemblies: the portable debug information travels inside each DLL (so the
         Runtime and Sql DLLs, which the core package carries as plain files, have it too), and Source Link points a
         debugger at the repository files. -->
    <DebugType>embedded</DebugType>
    <RepositoryUrl>https://github.com/neemle/orm.lite</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- XML documentation is generated for the shipped libraries (they set GenerateDocumentationFile); a member
         without a summary is not a build error, so the missing-documentation and malformed-comment warnings stay
         off. -->
    <NoWarn>$(NoWarn);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584</NoWarn>
    <NoWarn>$(NoWarn);CS1587;CS1591;CS1710;CS1711;CS1712</NoWarn>
  </PropertyGroup>

</Project>
