        DO $collision$ DECLARE r record; BEGIN IF to_regclass('"ce_accounts"') IS NOT NULL AND (SELECT count(*) FROM pg_attribute WHERE attrelid = to_regclass('"ce_accounts"') AND attnum > 0 AND NOT attisdropped AND attname = ANY (ARRAY['code', 'deleted_at'])) = 2 THEN FOR r IN SELECT ic.relname::text AS idx, c.conname::text AS con FROM pg_index i JOIN pg_class ic ON ic.oid = i.indexrelid LEFT JOIN pg_constraint c ON c.conindid = i.indexrelid AND c.contype IN ('u', 'p') WHERE i.indrelid = to_regclass('"ce_accounts"') AND i.indisunique AND i.indpred IS NULL AND i.indexprs IS NULL AND i.indnkeyatts = 1 AND (SELECT count(*) FROM unnest(i.indkey::int2[]) WITH ORDINALITY AS k(attnum, ord) JOIN pg_attribute a ON a.attrelid = i.indrelid AND a.attnum = k.attnum WHERE k.ord <= i.indnkeyatts AND a.attname = ANY (ARRAY['code'])) = 1 LOOP RAISE EXCEPTION 'Live-only index % on table % over columns (%) cannot take effect: % % is unique over the same columns without a live-row predicate', 'ix_ce_accounts_code_live', 'ce_accounts', 'code', CASE WHEN r.con IS NULL THEN 'index' ELSE 'constraint' END, COALESCE(r.con, r.idx) USING HINT = 'Convert it with an explicit migration: create the partial index, then drop the total one.'; END LOOP; END IF; END $collision$
