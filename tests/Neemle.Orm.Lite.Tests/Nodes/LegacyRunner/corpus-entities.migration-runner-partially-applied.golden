        DO $lc$ DECLARE owner_constraint name; BEGIN PERFORM set_config('lock_timeout', '5s', true); IF to_regclass('"uq_projects_title"') IS NOT NULL THEN CREATE UNIQUE INDEX IF NOT EXISTS "ix_projects_title_live" ON "ce_projects" ("tenant_id", lower("title")) WHERE "deleted_at" IS NULL; COMMENT ON INDEX "ix_projects_title_live" IS '0400_helper_blocks'; SELECT c.conname INTO owner_constraint FROM pg_constraint c WHERE c.conrelid = to_regclass('"ce_projects"') AND c.conindid = to_regclass('"uq_projects_title"') AND c.contype IN ('u', 'p'); IF owner_constraint IS NULL THEN DROP INDEX "uq_projects_title"; ELSE EXECUTE format('ALTER TABLE "ce_projects" DROP CONSTRAINT %I', owner_constraint); END IF; ELSE CREATE UNIQUE INDEX IF NOT EXISTS "ix_projects_title_live" ON "ce_projects" ("tenant_id", lower("title")) WHERE "deleted_at" IS NULL; END IF; END $lc$
