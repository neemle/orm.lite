    CREATE UNIQUE INDEX IF NOT EXISTS "ix_ce_tasks_project_id_name" ON "ce_tasks" ("project_id", "name")
    CREATE INDEX IF NOT EXISTS "ix_ce_everything_searchable" ON "ce_everything" ("searchable")
    CREATE UNIQUE INDEX IF NOT EXISTS "ix_ce_everything_unique" ON "ce_everything" ("unique")
