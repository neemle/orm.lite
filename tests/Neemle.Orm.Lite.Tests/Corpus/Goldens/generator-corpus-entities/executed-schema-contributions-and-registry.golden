-- schema
CreateAll: CREATE TABLE IF NOT EXISTS "ce_accounts" ("id" uuid NOT NULL PRIMARY KEY, "code" text NOT NULL DEFAULT '', "name" text NOT NULL DEFAULT '', "deleted_at" timestamp with time zone); CREATE TABLE IF NOT EXISTS "ce_projects" ("id" uuid NOT NULL PRIMARY KEY, "tenant_id" uuid NOT NULL, "title" text NOT NULL DEFAULT '', "state" text NOT NULL DEFAULT '', "updated_at" timestamp with time zone NOT NULL DEFAULT now(), "deleted_at" timestamp with time zone); CREATE TABLE IF NOT EXISTS "ce_project_labels" ("project_id" uuid NOT NULL, "label_id" uuid NOT NULL, PRIMARY KEY ("project_id", "label_id")); CREATE TABLE IF NOT EXISTS "ce_tasks" ("id" uuid NOT NULL PRIMARY KEY, "owner_scope" uuid NOT NULL, "project_id" uuid NOT NULL, "parent_id" uuid, "name" text NOT NULL DEFAULT '', "removed_at" timestamp with time zone); CREATE TABLE IF NOT EXISTS "ce_labels" ("id" uuid NOT NULL PRIMARY KEY, "text" text NOT NULL DEFAULT ''); CREATE TABLE IF NOT EXISTS "ce_members" ("id" uuid NOT NULL PRIMARY KEY, "handle" text NOT NULL DEFAULT '', "deleted_at" timestamp with time zone); CREATE TABLE IF NOT EXISTS "ce_everything" ("id" uuid NOT NULL PRIMARY KEY, "optional_guid" uuid, "text" text NOT NULL DEFAULT '', "optional_text" text, "count" integer NOT NULL DEFAULT 0, "optional_count" integer, "big" bigint NOT NULL DEFAULT 0, "flag" boolean NOT NULL DEFAULT false, "ratio" double precision NOT NULL DEFAULT 0, "amount" numeric(12, 4) NOT NULL, "stamp" timestamp with time zone NOT NULL DEFAULT now(), "optional_stamp" timestamp with time zone, "day" date NOT NULL, "optional_day" date, "level" text NOT NULL DEFAULT '', "optional_level" text, "document" jsonb NOT NULL DEFAULT '{}'::jsonb, "optional_document" jsonb, "custom_name" text NOT NULL DEFAULT '', "searchable" text NOT NULL DEFAULT '', "unique" text NOT NULL DEFAULT ''); CREATE TABLE IF NOT EXISTS "ce_keyless" ("note" text NOT NULL DEFAULT '', "counter" integer NOT NULL DEFAULT 0); CREATE TABLE IF NOT EXISTS "ce_internal" ("id" uuid NOT NULL PRIMARY KEY, "name" text NOT NULL DEFAULT '')
CreateIndexes:
    CREATE UNIQUE INDEX IF NOT EXISTS "ix_ce_accounts_code_live" ON "ce_accounts" ("code") WHERE "deleted_at" IS NULL
    CREATE INDEX IF NOT EXISTS "ix_ce_accounts_name" ON "ce_accounts" ("name")
    CREATE INDEX IF NOT EXISTS "ix_ce_projects_title" ON "ce_projects" ("title")
