-- schema
CreateAll: CREATE TABLE IF NOT EXISTS "fixture_notes" ("id" uuid NOT NULL PRIMARY KEY, "title" text NOT NULL DEFAULT '', "revision" integer NOT NULL DEFAULT 0); CREATE TABLE IF NOT EXISTS "golden_authors" ("id" uuid NOT NULL PRIMARY KEY, "name" text NOT NULL DEFAULT '', "rank" integer NOT NULL DEFAULT 0); CREATE TABLE IF NOT EXISTS "golden_author_tags" ("author_id" uuid NOT NULL, "tag_id" uuid NOT NULL, PRIMARY KEY ("author_id", "tag_id")); CREATE TABLE IF NOT EXISTS "golden_books" ("id" uuid NOT NULL PRIMARY KEY, "author_id" uuid NOT NULL, "editor_id" uuid, "title" text NOT NULL DEFAULT '', "pages" integer NOT NULL DEFAULT 0, "copies" bigint NOT NULL DEFAULT 0, "weight" double precision NOT NULL DEFAULT 0, "price" numeric(12, 4) NOT NULL, "in_print" boolean NOT NULL DEFAULT false, "format" text NOT NULL DEFAULT '', "published_at" timestamp with time zone NOT NULL DEFAULT now(), "released_on" date, "extras" jsonb); CREATE TABLE IF NOT EXISTS "golden_tags" ("id" uuid NOT NULL PRIMARY KEY, "label" text NOT NULL DEFAULT '')
CreateIndexes:
    CREATE INDEX IF NOT EXISTS "ix_fixture_notes_title" ON "fixture_notes" ("title")
ReconcileIndexes:
    SET LOCAL lock_timeout = '5s'
    DO $drift$ DECLARE current_index oid; BEGIN IF to_regclass('"fixture_notes"') IS NOT NULL AND (SELECT count(*) FROM pg_attribute WHERE attrelid = to_regclass('"fixture_notes"') AND attnum > 0 AND NOT attisdropped AND attname = ANY (ARRAY['title'])) = 1 THEN SELECT ic.oid INTO current_index FROM pg_index i JOIN pg_class ic ON ic.oid = i.indexrelid WHERE i.indrelid = to_regclass('"fixture_notes"') AND ic.relname = 'ix_fixture_notes_title'; IF current_index IS NULL AND EXISTS (SELECT 1 FROM pg_class x WHERE x.relname = 'ix_fixture_notes_title' AND x.relnamespace = (SELECT t.relnamespace FROM pg_class t WHERE t.oid = to_regclass('"fixture_notes"'))) THEN RAISE EXCEPTION 'Index name % is already held by another relation in the schema of table %: PostgreSQL index names are schema-global, so creating it would be skipped and the table would stay without its index. Rename the index.', 'ix_fixture_notes_title', 'fixture_notes'; END IF; IF current_index IS NOT NULL THEN CREATE TEMP TABLE "orm_ix_check" (LIKE "fixture_notes"); EXECUTE 'CREATE INDEX IF NOT EXISTS "ix_fixture_notes_title" ON "orm_ix_check" ("title")'; IF replace(pg_get_indexdef(current_index), concat(' ON ', (SELECT concat(quote_ident(n.nspname), '.', quote_ident(c.relname)) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.oid = to_regclass('"fixture_notes"')), ' USING '), ' USING ') <> regexp_replace(pg_get_indexdef(to_regclass('pg_temp."ix_fixture_notes_title"')), E' ON \\S+ USING ', ' USING ') THEN DROP TABLE pg_temp."orm_ix_check"; EXECUTE 'DROP INDEX ' || current_index::regclass; ELSE DROP TABLE pg_temp."orm_ix_check"; END IF; END IF; END IF; END $drift$
    DO $reconcile$ BEGIN IF to_regclass('"fixture_notes"') IS NOT NULL AND (SELECT count(*) FROM pg_attribute WHERE attrelid = to_regclass('"fixture_notes"') AND attnum > 0 AND NOT attisdropped AND attname = ANY (ARRAY['title'])) = 1 THEN EXECUTE 'CREATE INDEX IF NOT EXISTS "ix_fixture_notes_title" ON "fixture_notes" ("title")'; END IF; END $reconcile$
