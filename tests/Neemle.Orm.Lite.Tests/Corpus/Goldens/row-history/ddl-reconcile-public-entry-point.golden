[0] DO $rh$ BEGIN IF to_regclass('"corpus_tasks"') IS NOT NULL AND (NOT EXISTS (SELECT 1 FROM pg_trigger g WHERE g.tgrelid = to_regclass('"corpus_tasks"') AND g.tgname = 'row_history_u' AND obj_description(g.oid, 'pg_trigger') = 'f9f559f7dd954d26') OR NOT EXISTS (SELECT 1 FROM pg_trigger g WHERE g.tgrelid = to_regclass('"corpus_tasks"') AND g.tgname = 'row_history_d' AND obj_description(g.oid, 'pg_trigger') = 'f9f559f7dd954d26')) THEN CREATE OR REPLACE TRIGGER row_history_u AFTER UPDATE ON "corpus_tasks" FOR EACH ROW WHEN (OLD IS DISTINCT FROM NEW) EXECUTE FUNCTION row_history_capture('id', 'deleted_at', 'tenant_id', 'updated_at'); CREATE OR REPLACE TRIGGER row_history_d AFTER DELETE ON "corpus_tasks" FOR EACH ROW EXECUTE FUNCTION row_history_capture('id', 'deleted_at', 'tenant_id', 'updated_at'); COMMENT ON TRIGGER row_history_u ON "corpus_tasks" IS 'f9f559f7dd954d26'; COMMENT ON TRIGGER row_history_d ON "corpus_tasks" IS 'f9f559f7dd954d26'; END IF; END $rh$
