[0] DO $rh$ BEGIN IF to_regclass('"corpus_projects"') IS NOT NULL AND (NOT EXISTS (SELECT 1 FROM pg_trigger g WHERE g.tgrelid = to_regclass('"corpus_projects"') AND g.tgname = 'row_history_u' AND obj_description(g.oid, 'pg_trigger') = 'baecbad986619560') OR NOT EXISTS (SELECT 1 FROM pg_trigger g WHERE g.tgrelid = to_regclass('"corpus_projects"') AND g.tgname = 'row_history_d' AND obj_description(g.oid, 'pg_trigger') = 'baecbad986619560')) THEN CREATE OR REPLACE TRIGGER row_history_u AFTER UPDATE ON "corpus_projects" FOR EACH ROW WHEN (OLD IS DISTINCT FROM NEW) EXECUTE FUNCTION row_history_capture('id', 'deleted_at', 'id', 'a', 'b'); CREATE OR REPLACE TRIGGER row_history_d AFTER DELETE ON "corpus_projects" FOR EACH ROW EXECUTE FUNCTION row_history_capture('id', 'deleted_at', 'id', 'a', 'b'); COMMENT ON TRIGGER row_history_u ON "corpus_projects" IS 'baecbad986619560'; COMMENT ON TRIGGER row_history_d ON "corpus_projects" IS 'baecbad986619560'; END IF; END $rh$
