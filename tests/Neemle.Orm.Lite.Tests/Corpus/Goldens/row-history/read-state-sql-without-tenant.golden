SELECT (to_jsonb(live.*) || coalesce((SELECT jsonb_object_agg(x.k, x.v) FROM (SELECT DISTINCT ON (e.k) e.k, e.v FROM row_history h CROSS JOIN LATERAL jsonb_each(h.old_values) AS e(k, v) WHERE h.source_table = @t AND h.row_id = @id AND h.id >= @k ORDER BY e.k, h.id) x), '{}'::jsonb)) - ARRAY[]::text[] FROM "corpus_platform_items" live WHERE live."id" = @id AND EXISTS (SELECT 1 FROM row_history v WHERE v.id = @k AND v.source_table = @t AND v.row_id = @id)
