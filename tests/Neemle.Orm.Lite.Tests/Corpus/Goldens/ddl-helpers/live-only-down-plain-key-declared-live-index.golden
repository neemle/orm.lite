DO $lc$ DECLARE duplicate_key text; total_index oid; live_index oid; BEGIN PERFORM set_config('lock_timeout', '5s', true); SELECT ic.oid INTO live_index FROM pg_index i JOIN pg_class ic ON ic.oid = i.indexrelid WHERE i.indrelid = to_regclass('"samples"') AND ic.relname = 'ix_samples_name_live'; SELECT ic.oid INTO total_index FROM pg_index i JOIN pg_class ic ON ic.oid = i.indexrelid WHERE i.indrelid = to_regclass('"samples"') AND ic.relname = 'uq_samples_name'; IF coalesce(obj_description(live_index, 'pg_class'), '') = '0200_live_only' THEN SELECT concat_ws(', ', "name"::text) INTO duplicate_key FROM "samples" WHERE "name" IS NOT NULL GROUP BY "name" HAVING count(*) > 1 LIMIT 1; IF duplicate_key IS NOT NULL THEN RAISE EXCEPTION 'cannot recreate unique index uq_samples_name on samples (name): duplicate key % exists, nothing was deleted', quote_literal(duplicate_key); END IF; IF total_index IS NULL AND EXISTS (SELECT 1 FROM pg_class x WHERE x.relname = 'uq_samples_name' AND x.relnamespace = (SELECT t.relnamespace FROM pg_class t WHERE t.oid = to_regclass('"samples"'))) THEN RAISE EXCEPTION 'Index name % is already held by another relation in the schema of table %: PostgreSQL index names are schema-global, so creating it would be skipped and the table would stay without its index. Rename the index.', 'uq_samples_name', 'samples'; END IF; CREATE UNIQUE INDEX IF NOT EXISTS "uq_samples_name" ON "samples" ("name"); EXECUTE format('COMMENT ON INDEX %s IS NULL', live_index::regclass); END IF; END $lc$
