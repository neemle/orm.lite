DO $lc$ DECLARE owner_constraint name; total_index oid; live_index oid; BEGIN PERFORM set_config('lock_timeout', '5s', true); SELECT ic.oid INTO total_index FROM pg_index i JOIN pg_class ic ON ic.oid = i.indexrelid WHERE i.indrelid = to_regclass('"samples"') AND ic.relname = 'uq_samples_name'; SELECT ic.oid INTO live_index FROM pg_index i JOIN pg_class ic ON ic.oid = i.indexrelid WHERE i.indrelid = to_regclass('"samples"') AND ic.relname = 'ix_samples_name_live'; IF live_index IS NULL AND EXISTS (SELECT 1 FROM pg_class x WHERE x.relname = 'ix_samples_name_live' AND x.relnamespace = (SELECT t.relnamespace FROM pg_class t WHERE t.oid = to_regclass('"samples"'))) THEN RAISE EXCEPTION 'Index name % is already held by another relation in the schema of table %: PostgreSQL index names are schema-global, so creating it would be skipped and the table would stay without its index. Rename the index.', 'ix_samples_name_live', 'samples'; END IF; IF total_index IS NOT NULL THEN CREATE UNIQUE INDEX IF NOT EXISTS "ix_samples_name_live" ON "samples" ("name") WHERE "deleted_at" IS NULL; COMMENT ON INDEX "ix_samples_name_live" IS '0200_live_only'; SELECT c.conname INTO owner_constraint FROM pg_constraint c WHERE c.conrelid = to_regclass('"samples"') AND c.conindid = total_index AND c.contype IN ('u', 'p'); IF owner_constraint IS NULL THEN EXECUTE 'DROP INDEX ' || total_index::regclass; ELSE EXECUTE format('ALTER TABLE "samples" DROP CONSTRAINT %I', owner_constraint); END IF; ELSE CREATE UNIQUE INDEX IF NOT EXISTS "ix_samples_name_live" ON "samples" ("name") WHERE "deleted_at" IS NULL; END IF; END $lc$
