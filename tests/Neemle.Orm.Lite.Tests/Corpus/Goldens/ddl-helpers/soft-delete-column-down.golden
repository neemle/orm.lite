DO $sd$ DECLARE soft_rows bigint; BEGIN PERFORM set_config('lock_timeout', '5s', true); IF coalesce((SELECT col_description(a.attrelid, a.attnum) FROM pg_attribute a WHERE a.attrelid = to_regclass('"samples"') AND a.attname = 'deleted_at' AND NOT a.attisdropped), '') = '0300_soft_column' THEN SELECT count(*) INTO soft_rows FROM "samples" WHERE "deleted_at" IS NOT NULL; IF soft_rows > 0 THEN RAISE EXCEPTION 'cannot drop deleted_at from samples: % soft-deleted row(s) would read as live', soft_rows; END IF; ALTER TABLE "samples" DROP COLUMN "deleted_at"; END IF; END $sd$
