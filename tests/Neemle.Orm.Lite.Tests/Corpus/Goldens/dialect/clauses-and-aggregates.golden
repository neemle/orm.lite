[0] ReturningClause([]) = ""
[1] ReturningClause([a, b]) = " RETURNING \"a\", \"b\"\"c\""
[2] CoalesceAssignment = "c" = COALESCE(@p0, "c")
[3] AnyOfExpression = "c" = ANY(@p0)
[4] NullSafeEqualsExpression = "c" IS NOT DISTINCT FROM @p0
[5] CountFilterExpression = count(*) FILTER (WHERE "c" > @p0)
[6] CountDistinctExpression = count(DISTINCT "c")
[7] SumCoalescedExpression = COALESCE(SUM(COALESCE("c", 0)), 0)
[8] MinExpression = min("c")
[9] NowPlusMinutesExpression = now() + make_interval(mins => @p0)
[10] IncrementAssignment = "c" = COALESCE("c", 0) + @p0
[11] OrderDirectionClause(false,false) = " ASC NULLS LAST"
[12] OrderDirectionClause(true,false) = " DESC NULLS LAST"
[13] OrderDirectionClause(false,true) = " ASC NULLS FIRST"
[14] OrderDirectionClause(true,true) = " DESC NULLS FIRST"
