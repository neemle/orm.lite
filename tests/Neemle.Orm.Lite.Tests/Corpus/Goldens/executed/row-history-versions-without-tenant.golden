#1 ExecuteReader conn=1 source=primary tx=false
    sql:
        SELECT id, op, actor_user_id, actor_kind, ARRAY(SELECT k FROM jsonb_object_keys(old_values) AS k ORDER BY k), xact_id, changed_at FROM row_history WHERE source_table = @t AND row_id = @id ORDER BY id DESC
    @t = String "corpus_platform_items"
    @id = Guid a0000000-0000-0000-0000-00000000000a
