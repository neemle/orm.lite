#1 BEGIN conn=1 source=primary
#2 ExecuteNonQuery conn=1 source=primary tx=true
    sql:
        WITH st(state) AS (SELECT (to_jsonb(live.*) || coalesce((SELECT jsonb_object_agg(x.k, x.v) FROM (SELECT DISTINCT ON (e.k) e.k, e.v FROM row_history h CROSS JOIN LATERAL jsonb_each(h.old_values) AS e(k, v) WHERE h.source_table = @t AND h.row_id = @id AND h.id >= @k ORDER BY e.k, h.id) x), '{}'::jsonb)) - ARRAY['updated_at']::text[] FROM "corpus_tasks" live WHERE live."id" = @id AND live."tenant_id" = @w AND EXISTS (SELECT 1 FROM row_history v WHERE v.id = @k AND v.source_table = @t AND v.row_id = @id)) UPDATE "corpus_tasks" AS t SET "name" = r."name", "rank" = r."rank", "status" = r."status", "doc" = r."doc", "updated_at" = now() FROM st CROSS JOIN LATERAL jsonb_populate_record(NULL::"corpus_tasks", st.state) AS r WHERE t."id" = @id AND t."tenant_id" = @w AND t."deleted_at" IS NULL
    @t = String "corpus_tasks"
    @id = Guid a0000000-0000-0000-0000-00000000000a
    @k = Int64 9
    @w = Guid 10000000-0000-0000-0000-000000000001
#3 ExecuteNonQuery conn=1 source=primary tx=true
    sql:
        WITH st(state) AS (SELECT (to_jsonb(live.*) || coalesce((SELECT jsonb_object_agg(x.k, x.v) FROM (SELECT DISTINCT ON (e.k) e.k, e.v FROM row_history h CROSS JOIN LATERAL jsonb_each(h.old_values) AS e(k, v) WHERE h.source_table = @t AND h.row_id = @id AND h.id >= @k ORDER BY e.k, h.id) x), '{}'::jsonb)) - ARRAY[]::text[] FROM "corpus_platform_items" live WHERE live."id" = @id AND EXISTS (SELECT 1 FROM row_history v WHERE v.id = @k AND v.source_table = @t AND v.row_id = @id)) UPDATE "corpus_platform_items" AS t SET "code" = r."code" FROM st CROSS JOIN LATERAL jsonb_populate_record(NULL::"corpus_platform_items", st.state) AS r WHERE t."id" = @id AND t."deleted_at" IS NULL
    @t = String "corpus_platform_items"
    @id = Guid a0000000-0000-0000-0000-00000000000a
    @k = Int64 9
-- outcome
Int32 1 Int32 1
