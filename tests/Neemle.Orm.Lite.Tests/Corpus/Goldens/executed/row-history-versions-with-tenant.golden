#1 ExecuteReader conn=1 source=primary tx=false
    sql:
        SELECT id, op, actor_user_id, actor_kind, ARRAY(SELECT k FROM jsonb_object_keys(old_values) AS k ORDER BY k), xact_id, changed_at FROM row_history WHERE source_table = @t AND row_id = @id AND EXISTS (SELECT 1 FROM "corpus_tasks" r WHERE r."id" = @id AND r."tenant_id" = @w) ORDER BY id DESC
    @t = String "corpus_tasks"
    @id = Guid a0000000-0000-0000-0000-00000000000a
    @w = Guid 10000000-0000-0000-0000-000000000001
-- outcome
9 soft_delete Guid 40000000-0000-0000-0000-000000000004 user [deleted_at,name] 77 Utc; 8 update null system [rank] 70 Utc
