#1 ExecuteReader conn=1 source=primary tx=false
    sql:
        SELECT a.attname FROM pg_constraint k CROSS JOIN LATERAL unnest(k.conkey) WITH ORDINALITY AS c(attnum, ord) JOIN pg_attribute a ON a.attrelid = k.conrelid AND a.attnum = c.attnum WHERE k.conname = @n AND k.contype IN ('p', 'u', 'x') AND pg_table_is_visible(k.conrelid) ORDER BY c.ord
    @n = String "uq_corpus_tasks_name"
-- outcome
uq_corpus_tasks_name [tenant_id,name]
