#31 ExecuteNonQuery conn=1 source=primary tx=true
    sql:
        DO $drift$ DECLARE current_index oid; BEGIN IF to_regclass('"gn_orchards"') IS NOT NULL AND (SELECT count(*) FROM pg_attribute WHERE attrelid = to_regclass('"gn_orchards"') AND attnum > 0 AND NOT attisdropped AND attname = ANY (ARRAY['name', 'deleted_at'])) = 2 THEN SELECT ic.oid INTO current_index FROM pg_index i JOIN pg_class ic ON ic.oid = i.indexrelid WHERE i.indrelid = to_regclass('"gn_orchards"') AND ic.relname = 'ix_gn_orchards_name_live'; IF current_index IS NULL AND EXISTS (SELECT 1 FROM pg_class x WHERE x.relname = 'ix_gn_orchards_name_live' AND x.relnamespace = (SELECT t.relnamespace FROM pg_class t WHERE t.oid = to_regclass('"gn_orchards"'))) THEN RAISE EXCEPTION 'Index name % is already held by another relation in the schema of table %: PostgreSQL index names are schema-global, so creating it would be skipped and the table would stay without its index. Rename the index.', 'ix_gn_orchards_name_live', 'gn_orchards'; END IF; IF current_index IS NOT NULL THEN CREATE TEMP TABLE "orm_ix_check" (LIKE "gn_orchards"); EXECUTE 'CREATE UNIQUE INDEX IF NOT EXISTS "ix_gn_orchards_name_live" ON "orm_ix_check" ("name") WHERE "deleted_at" IS NULL'; IF replace(pg_get_indexdef(current_index), concat(' ON ', (SELECT concat(quote_ident(n.nspname), '.', quote_ident(c.relname)) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.oid = to_regclass('"gn_orchards"')), ' USING '), ' USING ') <> regexp_replace(pg_get_indexdef(to_regclass('pg_temp."ix_gn_orchards_name_live"')), E' ON \\S+ USING ', ' USING ') THEN DROP TABLE pg_temp."orm_ix_check"; EXECUTE 'DROP INDEX ' || current_index::regclass; ELSE DROP TABLE pg_temp."orm_ix_check"; END IF; END IF; END IF; END $drift$
