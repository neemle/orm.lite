-- schema
CreateAll: CREATE TABLE IF NOT EXISTS "gn_orchards" ("id" uuid NOT NULL PRIMARY KEY, "name" text NOT NULL DEFAULT '', "climate" text NOT NULL DEFAULT '', "deleted_at" timestamp with time zone); CREATE TABLE IF NOT EXISTS "gn_trees" ("id" uuid NOT NULL PRIMARY KEY, "orchard_id" uuid NOT NULL, "species" text NOT NULL DEFAULT '', "age" integer NOT NULL DEFAULT 0)
CreateIndexes:
    CREATE UNIQUE INDEX IF NOT EXISTS "ix_gn_orchards_name_live" ON "gn_orchards" ("name") WHERE "deleted_at" IS NULL
    CREATE UNIQUE INDEX IF NOT EXISTS "ix_gn_trees_orchard_id_species" ON "gn_trees" ("orchard_id", "species")
ReconcileIndexes:
    SET LOCAL lock_timeout = '5s'
    DO $drift$ DECLARE current_index oid; BEGIN IF to_regclass('"gn_orchards"') IS NOT NULL AND (SELECT count(*) FROM pg_attribute WHERE attrelid = to_regclass('"gn_orchards"') AND attnum > 0 AND NOT attisdropped AND attname = ANY (ARRAY['name', 'deleted_at'])) = 2 THEN SELECT ic.oid INTO current_index FROM pg_index i JOIN pg_class ic ON ic.oid = i.indexrelid WHERE i.indrelid = to_regclass('"gn_orchards"') AND ic.relname = 'ix_gn_orchards_name_live'; IF current_index IS NULL AND EXISTS (SELECT 1 FROM pg_class x WHERE x.relname = 'ix_gn_orchards_name_live' AND x.relnamespace = (SELECT t.relnamespace FROM pg_class t WHERE t.oid = to_regclass('"gn_orchards"'))) THEN RAISE EXCEPTION 'Index name % is already held by another relation in the schema of table %: PostgreSQL index names are schema-global, so creating it would be skipped and the table would stay without its index. Rename the index.', 'ix_gn_orchards_name_live', 'gn_orchards'; END IF; IF current_index IS NOT NULL THEN CREATE TEMP TABLE "orm_ix_check" (LIKE "gn_orchards"); EXECUTE 'CREATE UNIQUE INDEX IF NOT EXISTS "ix_gn_orchards_name_live" ON "orm_ix_check" ("name") WHERE "deleted_at" IS NULL'; IF replace(pg_get_indexdef(current_index), concat(' ON ', (SELECT concat(quote_ident(n.nspname), '.', quote_ident(c.relname)) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.oid = to_regclass('"gn_orchards"')), ' USING '), ' USING ') <> regexp_replace(pg_get_indexdef(to_regclass('pg_temp."ix_gn_orchards_name_live"')), E' ON \\S+ USING ', ' USING ') THEN DROP TABLE pg_temp."orm_ix_check"; EXECUTE 'DROP INDEX ' || current_index::regclass; ELSE DROP TABLE pg_temp."orm_ix_check"; END IF; END IF; END IF; END $drift$
    DO $reconcile$ BEGIN IF to_regclass('"gn_orchards"') IS NOT NULL AND (SELECT count(*) FROM pg_attribute WHERE attrelid = to_regclass('"gn_orchards"') AND attnum > 0 AND NOT attisdropped AND attname = ANY (ARRAY['name', 'deleted_at'])) = 2 THEN EXECUTE 'CREATE UNIQUE INDEX IF NOT EXISTS "ix_gn_orchards_name_live" ON "gn_orchards" ("name") WHERE "deleted_at" IS NULL'; END IF; END $reconcile$
    DO $collision$ DECLARE r record; BEGIN IF to_regclass('"gn_orchards"') IS NOT NULL AND (SELECT count(*) FROM pg_attribute WHERE attrelid = to_regclass('"gn_orchards"') AND attnum > 0 AND NOT attisdropped AND attname = ANY (ARRAY['name', 'deleted_at'])) = 2 THEN FOR r IN SELECT ic.relname::text AS idx, c.conname::text AS con FROM pg_index i JOIN pg_class ic ON ic.oid = i.indexrelid LEFT JOIN pg_constraint c ON c.conindid = i.indexrelid AND c.contype IN ('u', 'p') WHERE i.indrelid = to_regclass('"gn_orchards"') AND i.indisunique AND i.indpred IS NULL AND i.indexprs IS NULL AND i.indnkeyatts = 1 AND (SELECT count(*) FROM unnest(i.indkey::int2[]) WITH ORDINALITY AS k(attnum, ord) JOIN pg_attribute a ON a.attrelid = i.indrelid AND a.attnum = k.attnum WHERE k.ord <= i.indnkeyatts AND a.attname = ANY (ARRAY['name'])) = 1 LOOP RAISE EXCEPTION 'Live-only index % on table % over columns (%) cannot take effect: % % is unique over the same columns without a live-row predicate', 'ix_gn_orchards_name_live', 'gn_orchards', 'name', CASE WHEN r.con IS NULL THEN 'index' ELSE 'constraint' END, COALESCE(r.con, r.idx) USING HINT = 'Convert it with an explicit migration: create the partial index, then drop the total one.'; END LOOP; END IF; END $collision$
    DO $drift$ DECLARE current_index oid; BEGIN IF to_regclass('"gn_trees"') IS NOT NULL AND (SELECT count(*) FROM pg_attribute WHERE attrelid = to_regclass('"gn_trees"') AND attnum > 0 AND NOT attisdropped AND attname = ANY (ARRAY['orchard_id', 'species'])) = 2 THEN SELECT ic.oid INTO current_index FROM pg_index i JOIN pg_class ic ON ic.oid = i.indexrelid WHERE i.indrelid = to_regclass('"gn_trees"') AND ic.relname = 'ix_gn_trees_orchard_id_species'; IF current_index IS NULL AND EXISTS (SELECT 1 FROM pg_class x WHERE x.relname = 'ix_gn_trees_orchard_id_species' AND x.relnamespace = (SELECT t.relnamespace FROM pg_class t WHERE t.oid = to_regclass('"gn_trees"'))) THEN RAISE EXCEPTION 'Index name % is already held by another relation in the schema of table %: PostgreSQL index names are schema-global, so creating it would be skipped and the table would stay without its index. Rename the index.', 'ix_gn_trees_orchard_id_species', 'gn_trees'; END IF; IF current_index IS NOT NULL THEN CREATE TEMP TABLE "orm_ix_check" (LIKE "gn_trees"); EXECUTE 'CREATE UNIQUE INDEX IF NOT EXISTS "ix_gn_trees_orchard_id_species" ON "orm_ix_check" ("orchard_id", "species")'; IF replace(pg_get_indexdef(current_index), concat(' ON ', (SELECT concat(quote_ident(n.nspname), '.', quote_ident(c.relname)) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.oid = to_regclass('"gn_trees"')), ' USING '), ' USING ') <> regexp_replace(pg_get_indexdef(to_regclass('pg_temp."ix_gn_trees_orchard_id_species"')), E' ON \\S+ USING ', ' USING ') THEN DROP TABLE pg_temp."orm_ix_check"; EXECUTE 'DROP INDEX ' || current_index::regclass; ELSE DROP TABLE pg_temp."orm_ix_check"; END IF; END IF; END IF; END $drift$
    DO $reconcile$ BEGIN IF to_regclass('"gn_trees"') IS NOT NULL AND (SELECT count(*) FROM pg_attribute WHERE attrelid = to_regclass('"gn_trees"') AND attnum > 0 AND NOT attisdropped AND attname = ANY (ARRAY['orchard_id', 'species'])) = 2 THEN EXECUTE 'CREATE UNIQUE INDEX IF NOT EXISTS "ix_gn_trees_orchard_id_species" ON "gn_trees" ("orchard_id", "species")'; END IF; END $reconcile$
