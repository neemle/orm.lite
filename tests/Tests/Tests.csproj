<Project Sdk="Microsoft.NET.Sdk">

  <!-- The library's own tests. They drive the generator over fixture sources through CSharpGeneratorDriver and
       the query layer over a real in-process Microsoft.Data.Sqlite connection, so the project needs no
       container or service. What SQLite cannot prove (the jsonb type, its operators and casts, the history
       trigger, advisory locks) is a property of the server and is exercised where a PostgreSQL is available. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="OrmLiteGolden/Fixtures/**" />
    <Compile Remove="Corpus/GeneratorFixtures/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generator is referenced as an ORDINARY assembly, not as an analyzer: this project DRIVES it over
         fixture sources and reads back the diagnostics and the emitted text, whereas an analyzer reference would
         run it over this project's own files and leave nothing to assert against. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <ProjectReference Include="../../src/Runtime/Runtime.csproj" />
    <ProjectReference Include="../../src/Sql/Sql.csproj" />
    <ProjectReference Include="../../src/Postgres/Postgres.csproj" />
    <ProjectReference Include="../../src/Sqlite/Sqlite.csproj" />
    <ProjectReference Include="../../src/Generator/Generator.csproj" />
  </ItemGroup>

  <!-- The composer-only gate (Gates/ComposerEscapeScan.cs) must see what the generator compiles, and a call under
       #if NET or #if DEBUG is compiled. So the preprocessor symbols are read from the Generator project itself, for each
       configuration it is built in, and carried into this assembly as metadata; nothing here lists a symbol. -->
  <PropertyGroup>
    <_OrmLiteGeneratorProject>$(MSBuildThisFileDirectory)../../src/Generator/Generator.csproj</_OrmLiteGeneratorProject>
    <_OrmLiteDefineConstantsTargets>$(MSBuildThisFileDirectory)Gates/GeneratorDefineConstants.targets</_OrmLiteDefineConstantsTargets>
  </PropertyGroup>

  <Target Name="ReadGeneratorDefineConstants" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="$(_OrmLiteGeneratorProject)" Targets="OrmLiteGeneratorDefineConstants"
             Properties="Configuration=Release;CustomAfterMicrosoftCommonTargets=$(_OrmLiteDefineConstantsTargets)">
      <Output TaskParameter="TargetOutputs" ItemName="_OrmLiteGeneratorReleaseSymbol" />
    </MSBuild>
    <MSBuild Projects="$(_OrmLiteGeneratorProject)" Targets="OrmLiteGeneratorDefineConstants"
             Properties="Configuration=Debug;CustomAfterMicrosoftCommonTargets=$(_OrmLiteDefineConstantsTargets)">
      <Output TaskParameter="TargetOutputs" ItemName="_OrmLiteGeneratorDebugSymbol" />
    </MSBuild>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>OrmLite.GeneratorDefineConstants.Release</_Parameter1>
        <_Parameter2>@(_OrmLiteGeneratorReleaseSymbol)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>OrmLite.GeneratorDefineConstants.Debug</_Parameter1>
        <_Parameter2>@(_OrmLiteGeneratorDebugSymbol)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
