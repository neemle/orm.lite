DO $fk$ DECLARE current_action text; BEGIN PERFORM set_config('lock_timeout', '5s', true); SELECT c.confdeltype::text INTO current_action FROM pg_constraint c WHERE c.contype = 'f' AND c.conname = 'fk_samples_scope' AND c.conrelid = to_regclass('"samples"'); IF current_action IS NOT NULL AND current_action <> 'r' THEN ALTER TABLE "samples" DROP CONSTRAINT "fk_samples_scope", ADD CONSTRAINT "fk_samples_scope" FOREIGN KEY ("tenant_id", "owner_id") REFERENCES "owners" ("tenant_id", "id") ON UPDATE RESTRICT ON DELETE RESTRICT; END IF; END $fk$
