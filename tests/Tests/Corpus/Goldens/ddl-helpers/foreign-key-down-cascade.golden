DO $fk$ DECLARE current_action text; BEGIN PERFORM set_config('lock_timeout', '5s', true); SELECT c.confdeltype::text INTO current_action FROM pg_constraint c WHERE c.contype = 'f' AND c.conname = 'fk_samples_owner' AND c.conrelid = to_regclass('"samples"'); IF current_action IS NOT NULL AND current_action <> 'a' THEN ALTER TABLE "samples" DROP CONSTRAINT "fk_samples_owner", ADD CONSTRAINT "fk_samples_owner" FOREIGN KEY ("owner_id") REFERENCES "owners" ("id") ON UPDATE NO ACTION ON DELETE NO ACTION; END IF; END $fk$
