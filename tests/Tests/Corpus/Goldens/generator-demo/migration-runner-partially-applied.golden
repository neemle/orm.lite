    sql:
        SET LOCAL lock_timeout = '5s'
#21 ExecuteNonQuery conn=1 source=primary tx=true
    sql:
        DO $drift$ DECLARE current_index oid; BEGIN IF to_regclass('"notes"') IS NOT NULL AND (SELECT count(*) FROM pg_attribute WHERE attrelid = to_regclass('"notes"') AND attnum > 0 AND NOT attisdropped AND attname = ANY (ARRAY['tenant_id', 'title', 'deleted_at'])) = 3 THEN SELECT ic.oid INTO current_index FROM pg_index i JOIN pg_class ic ON ic.oid = i.indexrelid WHERE i.indrelid = to_regclass('"notes"') AND ic.relname = 'ix_notes_tenant_id_title_live'; IF current_index IS NULL AND EXISTS (SELECT 1 FROM pg_class x WHERE x.relname = 'ix_notes_tenant_id_title_live' AND x.relnamespace = (SELECT t.relnamespace FROM pg_class t WHERE t.oid = to_regclass('"notes"'))) THEN RAISE EXCEPTION 'Index name % is already held by another relation in the schema of table %: PostgreSQL index names are schema-global, so creating it would be skipped and the table would stay without its index. Rename the index.', 'ix_notes_tenant_id_title_live', 'notes'; END IF; IF current_index IS NOT NULL THEN CREATE TEMP TABLE "orm_ix_check" (LIKE "notes"); EXECUTE 'CREATE UNIQUE INDEX IF NOT EXISTS "ix_notes_tenant_id_title_live" ON "orm_ix_check" ("tenant_id", "title") WHERE "deleted_at" IS NULL'; IF replace(pg_get_indexdef(current_index), concat(' ON ', (SELECT concat(quote_ident(n.nspname), '.', quote_ident(c.relname)) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.oid = to_regclass('"notes"')), ' USING '), ' USING ') <> regexp_replace(pg_get_indexdef(to_regclass('pg_temp."ix_notes_tenant_id_title_live"')), E' ON \\S+ USING ', ' USING ') THEN DROP TABLE pg_temp."orm_ix_check"; EXECUTE 'DROP INDEX ' || current_index::regclass; ELSE DROP TABLE pg_temp."orm_ix_check"; END IF; END IF; END IF; END $drift$
#22 ExecuteNonQuery conn=1 source=primary tx=true
    sql:
        DO $reconcile$ BEGIN IF to_regclass('"notes"') IS NOT NULL AND (SELECT count(*) FROM pg_attribute WHERE attrelid = to_regclass('"notes"') AND attnum > 0 AND NOT attisdropped AND attname = ANY (ARRAY['tenant_id', 'title', 'deleted_at'])) = 3 THEN EXECUTE 'CREATE UNIQUE INDEX IF NOT EXISTS "ix_notes_tenant_id_title_live" ON "notes" ("tenant_id", "title") WHERE "deleted_at" IS NULL'; END IF; END $reconcile$
#23 ExecuteNonQuery conn=1 source=primary tx=true
    sql:
        DO $collision$ DECLARE r record; BEGIN IF to_regclass('"notes"') IS NOT NULL AND (SELECT count(*) FROM pg_attribute WHERE attrelid = to_regclass('"notes"') AND attnum > 0 AND NOT attisdropped AND attname = ANY (ARRAY['tenant_id', 'title', 'deleted_at'])) = 3 THEN FOR r IN SELECT ic.relname::text AS idx, c.conname::text AS con FROM pg_index i JOIN pg_class ic ON ic.oid = i.indexrelid LEFT JOIN pg_constraint c ON c.conindid = i.indexrelid AND c.contype IN ('u', 'p') WHERE i.indrelid = to_regclass('"notes"') AND i.indisunique AND i.indpred IS NULL AND i.indexprs IS NULL AND i.indnkeyatts = 2 AND (SELECT count(*) FROM unnest(i.indkey::int2[]) WITH ORDINALITY AS k(attnum, ord) JOIN pg_attribute a ON a.attrelid = i.indrelid AND a.attnum = k.attnum WHERE k.ord <= i.indnkeyatts AND a.attname = ANY (ARRAY['tenant_id', 'title'])) = 2 LOOP RAISE EXCEPTION 'Live-only index % on table % over columns (%) cannot take effect: % % is unique over the same columns without a live-row predicate', 'ix_notes_tenant_id_title_live', 'notes', 'tenant_id, title', CASE WHEN r.con IS NULL THEN 'index' ELSE 'constraint' END, COALESCE(r.con, r.idx) USING HINT = 'Convert it with an explicit migration: create the partial index, then drop the total one.'; END LOOP; END IF; END $collision$
