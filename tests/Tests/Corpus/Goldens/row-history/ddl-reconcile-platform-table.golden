[0] DO $rh$ BEGIN IF to_regclass('"corpus_platform_items"') IS NOT NULL AND (NOT EXISTS (SELECT 1 FROM pg_trigger g WHERE g.tgrelid = to_regclass('"corpus_platform_items"') AND g.tgname = 'row_history_u' AND obj_description(g.oid, 'pg_trigger') = '0cd466b26777dff0') OR NOT EXISTS (SELECT 1 FROM pg_trigger g WHERE g.tgrelid = to_regclass('"corpus_platform_items"') AND g.tgname = 'row_history_d' AND obj_description(g.oid, 'pg_trigger') = '0cd466b26777dff0')) THEN CREATE OR REPLACE TRIGGER row_history_u AFTER UPDATE ON "corpus_platform_items" FOR EACH ROW WHEN (OLD IS DISTINCT FROM NEW) EXECUTE FUNCTION row_history_capture('id', 'deleted_at', ''); CREATE OR REPLACE TRIGGER row_history_d AFTER DELETE ON "corpus_platform_items" FOR EACH ROW EXECUTE FUNCTION row_history_capture('id', 'deleted_at', ''); COMMENT ON TRIGGER row_history_u ON "corpus_platform_items" IS '0cd466b26777dff0'; COMMENT ON TRIGGER row_history_d ON "corpus_platform_items" IS '0cd466b26777dff0'; END IF; END $rh$
