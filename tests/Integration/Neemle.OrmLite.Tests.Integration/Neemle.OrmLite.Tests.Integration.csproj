<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Integration tier: tests against a real database, SQLite in-process and PostgreSQL at ORMLITE_TEST_POSTGRES
       (a PostgreSQL test skips without it, and the CI step's SkipGate witness list fails the job when one did not
       pass). The generator runs over this project as an analyzer, as it does for a package consumer, so the entities
       here get their real generated code. A test that runs on doubles only belongs to
       tests/Unit/Neemle.OrmLite.Tests.Unit; a test lives in exactly one tier, and each tier's coverage is measured on
       its own. The folder carries the full name, so the assembly name is set here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <AssemblyName>Neemle.OrmLite.Tests.Integration</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <IntegrationComposerPackage>neemle.csharpcomposer/$(OrmLiteComposerVersion)</IntegrationComposerPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <!-- The generator's own dependency, which an analyzer project reference does not bring, as in tests/AotSmoke: the
       restore of the Generator project puts it in the package folder. -->
  <ItemGroup>
    <Analyzer Include="$(NuGetPackageRoot)$(IntegrationComposerPackage)/lib/net10.0/Neemle.CSharpComposer.dll" />
    <ProjectReference Include="../../../src/Runtime/Runtime.csproj" />
    <ProjectReference Include="../../../src/Generator/Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/Sql/Sql.csproj" />
    <ProjectReference Include="../../../src/Postgres/Postgres.csproj" />
    <ProjectReference Include="../../../src/Sqlite/Sqlite.csproj" />
  </ItemGroup>

</Project>
