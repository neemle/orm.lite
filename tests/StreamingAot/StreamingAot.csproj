<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <StreamingTfm Condition="'$(StreamingTfm)' == ''">net10.0</StreamingTfm>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(StreamingTfm)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <NuGetAudit>false</NuGetAudit>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(ArtifactsPath)/generated/StreamingAot</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Runtime/Runtime.csproj" />
    <ProjectReference Include="../../src/Sql/Sql.csproj" />
    <ProjectReference Include="../../src/Sqlite/Sqlite.csproj" />
    <ProjectReference Include="../../src/Postgres/Postgres.csproj" />
    <ProjectReference Include="../../src/Generator/Generator.csproj" OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <PackageReference Include="Neemle.CSharpComposer" Version="$(OrmLiteComposerVersion)"
                      GeneratePathProperty="true" />
    <Analyzer Include="$(PkgNeemle_CSharpComposer)/lib/net10.0/Neemle.CSharpComposer.dll" />
  </ItemGroup>
</Project>
