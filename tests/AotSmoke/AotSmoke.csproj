<Project Sdk="Microsoft.NET.Sdk">

  <!-- ORML-66 (n4): a NativeAOT consumer of the runtime. It is built by the aot-smoke job of .github/workflows/ci.yml
       with `dotnet publish tests/AotSmoke -c Release -r linux-x64`, and it is NOT part of Neemle.Orm.Lite.slnx, so
       the ordinary build and test jobs never publish it. The job runs once per .NET runtime and passes
       -p:AotSmokeTfm=net10.0 or net11.0; the shipped libraries stay net10.0 and a net11.0 consumer references them as
       they are. A plain publish without the property targets net10.0. -->
  <PropertyGroup>
    <AotSmokeTfm Condition="'$(AotSmokeTfm)' == ''">net10.0</AotSmokeTfm>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(AotSmokeTfm)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Neemle.Orm.Lite.Runtime/Neemle.Orm.Lite.Runtime.csproj" />
    <ProjectReference Include="../../src/Neemle.Orm.Lite.Sql/Neemle.Orm.Lite.Sql.csproj" />
    <ProjectReference Include="../../src/Neemle.Orm.Lite.Postgres/Neemle.Orm.Lite.Postgres.csproj" />
  </ItemGroup>

</Project>
